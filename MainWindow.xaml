<Window x:Class="NetworkAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализатор сетевых подключений" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Сетевые интерфейсы" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

        <ListBox Grid.Row="1" Grid.Column="0" x:Name="InterfacesListBox" 
                 DisplayMemberPath="Name" 
                 SelectionChanged="InterfacesListBox_SelectionChanged"
                 Margin="0,0,5,0"/>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5,0,0,0">
                <TextBlock Text="Информация о выбранном интерфейсе" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="InterfaceDetailsTextBox" IsReadOnly="True" TextWrapping="Wrap" 
                         Height="200" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="LightGray" Margin="0,10,0,0">
            <Grid Margin="0,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Анализ URL/URI" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>

                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="URL:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="UrlTextBox" Grid.Column="1" Margin="0,0,5,0"/>
                    <Button x:Name="AnalyzeButton" Grid.Column="2" Content="Анализировать" Click="AnalyzeButton_Click" Padding="5,2"/>
                </Grid>

                <GroupBox Grid.Row="2" Header="Результаты разбора URL" Margin="0,0,0,5">
                    <TextBox x:Name="UrlParseResultTextBox" IsReadOnly="True" TextWrapping="Wrap" Height="100"/>
                </GroupBox>

                <Grid Grid.Row="3" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Grid.Column="0" Header="Проверка доступности (Ping)" Margin="0,0,5,0">
                        <StackPanel>
                            <Button x:Name="PingButton" Content="Пинговать" Click="PingButton_Click" Padding="5,2" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <TextBox x:Name="PingResultTextBox" IsReadOnly="True" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="0" Grid.Column="1" Header="DNS и тип адреса" Margin="5,0,0,0">
                        <StackPanel>
                            <Button x:Name="DnsButton" Content="Получить DNS" Click="DnsButton_Click" Padding="5,2" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                            <TextBox x:Name="DnsResultTextBox" IsReadOnly="True" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="История проверенных URL" Margin="0,5,0,0">
                        <ListBox x:Name="HistoryListBox" Height="100" SelectionChanged="HistoryListBox_SelectionChanged"/>
                    </GroupBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
